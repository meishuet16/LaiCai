# Copy to a protected local secret file; replace placeholders from the intended
# RetainIQ synthetic-demo project's Supabase Dashboard. Never commit the copy.
RETAINIQ_DATABASE_BACKEND=supabase
RETAINIQ_SUPABASE_PROJECT_URL=https://<PROJECT_REF>.supabase.co
RETAINIQ_SUPABASE_EXPECTED_PROJECT_REF=<PROJECT_REF>
RETAINIQ_SUPABASE_CONNECTION_MODE=SESSION_POOLER
# Use the app role's Dashboard connection string. Keep DB credentials server-side.
RETAINIQ_SUPABASE_DB_APP_DSN=postgresql://<APP_ROLE>.<PROJECT_REF>:<APP_PASSWORD>@<DASHBOARD_POOLER_HOST>:5432/postgres?sslmode=require
# Use a separate retaniq_maintenance-capability LOGIN through a session-capable connection.
RETAINIQ_SUPABASE_DB_MAINTENANCE_DSN=postgresql://<MAINTENANCE_ROLE>.<PROJECT_REF>:<MAINTENANCE_PASSWORD>@<DASHBOARD_POOLER_HOST>:5432/postgres?sslmode=require
# Use the separate migration role's DIRECT Dashboard connection string.
RETAINIQ_SUPABASE_DB_MIGRATION_DSN=postgresql://<MIGRATION_ROLE>:<MIGRATION_PASSWORD>@<DASHBOARD_DIRECT_HOST>:5432/postgres?sslmode=require
